{
  "name": "@chronicle/testing",
  "version": "0.1.0",
  "description": "Test utilities and in-memory adapter for chronicle migrations.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chronicle/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  },
  "engines": { "node": ">=22" }
}
